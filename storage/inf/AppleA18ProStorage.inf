[Version]
Signature="$WINDOWS NT$"
Class=SCSIAdapter
ClassGuid={4D36E97B-E325-11CE-BFC1-08002BE10318}
Provider=%Apple%
DriverVer=06/21/2026,1.0.0.0
CatalogFile=AppleA18ProStorage.cat

[Manufacturer]
%Apple%=AppleStorage,NTx86,NTamd64,NTarm64

[AppleStorage.NTx86]
%AppleA18ProStorage%=AppleA18ProStorage_Device,PCI\VEN_106B&DEV_16B1

[AppleStorage.NTamd64]
%AppleA18ProStorage%=AppleA18ProStorage_Device,PCI\VEN_106B&DEV_16B1

[AppleStorage.NTarm64]
%AppleA18ProStorage%=AppleA18ProStorage_Device,PCI\VEN_106B&DEV_16B1

[AppleA18ProStorage_Device]
